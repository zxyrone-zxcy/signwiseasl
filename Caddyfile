{
	frankenphp
	order php_server before file_server
}

:{$PORT:80} {
	root * /app/public
	encode zstd gzip

	@hashedAssets path /build/assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	@templates path /sign-templates.json
	header @templates Cache-Control "no-cache"

	@mediapipe path /mediapipe/*
	header @mediapipe Cache-Control "public, max-age=604800"
	php_server
}
